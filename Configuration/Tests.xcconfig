// Shared build settings; project/target differences belong in their owning configuration.

BUNDLE_LOADER = $(TEST_HOST)
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM = 79V43DNG7H
GENERATE_INFOPLIST_FILE = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
MARKETING_VERSION = 1.0
PRODUCT_BUNDLE_IDENTIFIER = org.chantxu.MoviePilot-TV-Tests
PRODUCT_NAME = $(TARGET_NAME)
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_EMIT_LOC_STRINGS = NO
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 3
TEST_HOST = $(BUILT_PRODUCTS_DIR)/MoviePilot-TV.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/MoviePilot-TV
TVOS_DEPLOYMENT_TARGET = 18.0
